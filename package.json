{
  "name": "simplebrains-website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:workspace": "node ./scripts/setup-workspace.mjs",
    "dev": "npm run setup:workspace && astro dev",
