# Pick ONE connection mode:

# Local vault — `npm run setup:workspace` creates `.omgbase/`.
# OMG_WORKSPACE=/Users/brendan/notes
# OMG_REPO=notes

# Remote Streamable HTTP MCP (same as Cursor omg / `omg --server`).
# Uses the minimal tool profile (`query` + `docs_read` + `changes_since`).
# OMG_URL=https://example.invalid/mcp
# OMG_TOKEN=

# Preview drafts (default on in development, off for production builds)
OMG_INCLUDE_DRAFTS=1
