---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="mastfoot wrap">
    <div class="footer-brand-block">
      <a class="footer-brand" href="/" aria-label="Simplebrains home">
        <img
          class="footer-brain"
          src="/brand/simplebrains-brain.svg"
          width="22"
          height="20"
          alt=""
          decoding="async"
        />
        <img
          class="footer-wordmark"
          src="/brand/simplebrains-wordmark.svg"
          width="140"
          height="26"
          alt="Simplebrains"
          decoding="async"
        />
      </a>
      <p class="footer-copy">© {year} · An independent studio for humane software</p>
    </div>
    <p class="footer-links">
      <a href="mailto:brendan@simplebrains.com">brendan@simplebrains.com</a>
      <span class="footer-sep" aria-hidden="true">·</span>
      <a href="tel:+12085764839">+1-208-576-4839</a>
      <span class="footer-sep" aria-hidden="true">·</span>
      <a href="https://github.com/simplebrains" target="_blank" rel="noopener noreferrer">GitHub</a>
    </p>
  </div>
</footer>
