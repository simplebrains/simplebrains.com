---
import { publicAsset } from "../lib/assets";

const brainSrc = publicAsset("/brand/simplebrains-brain.svg");
const wordmarkSrc = publicAsset("/brand/simplebrains-wordmark.svg");
---

<header class="site-header">
  <div class="masthead wrap">
    <a class="brand" href="/" aria-label="Simplebrains home">
      <img
        class="brand-brain"
        src={brainSrc}
        width="32"
        height="29"
        alt=""
        decoding="async"
      />
      <img
        class="brand-wordmark"
        src={wordmarkSrc}
        width="180"
        height="33"
        alt="Simplebrains"
        decoding="async"
      />
    </a>
  </div>
</header>
