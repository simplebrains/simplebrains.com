---
---

<header class="site-header">
  <div class="masthead wrap">
    <a class="brand" href="/" aria-label="Simplebrains home">
      <img
        class="brand-brain"
        src="/brand/simplebrains-brain.svg"
        width="32"
        height="29"
        alt=""
        decoding="async"
      />
      <img
        class="brand-wordmark"
        src="/brand/simplebrains-wordmark.svg"
        width="180"
        height="33"
        alt="Simplebrains"
        decoding="async"
      />
    </a>
    <p class="tagline">An independent studio for humane software</p>
    <input
      type="checkbox"
      id="menu-toggle"
      aria-controls="nav-links"
      aria-expanded="false"
    />
    <label for="menu-toggle" class="hamburger-menu" aria-label="Menu">☰</label>
    <nav class="nav-cta" id="nav-links">
      <a
        class="btn btn-ghost"
        href="https://github.com/simplebrains"
        target="_blank"
        rel="noopener noreferrer">GitHub</a
      >
      <a class="btn btn-ink" href="#built-by"
        >About <span class="arr" aria-hidden="true">→</span></a
      >
    </nav>
  </div>
</header>
